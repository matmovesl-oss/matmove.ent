{
  "routes": [
    {
      "src": "/api/cancel-ride/?",
      "dest": "/api/accept-ride-escrow?action=cancel"
    },
    {
      "src": "/api/reconcile-ride-payments/?",
      "dest": "/api/accept-ride-escrow?action=reconcile"
    },
    {
      "src": "/api/process-monime-webhooks/?",
      "dest": "/api/create-monime-payout?action=monime_webhooks"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/process-monime-webhooks",
      "schedule": "* * * * *"
    }
  ]
}
